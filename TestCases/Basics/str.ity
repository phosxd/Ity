#EXPECT
#addition
#ab
#abc
#abcabc
#access
#a
#e
#method length
#5
#method append
#abcdefghi
#method erase
#abcefghi
#method raw
#97
#END

# Declaration / Reassign
# -----------------------

const STR conststr = 'abcde';

var STR str = 'a'; # Declare.
str = 'b'; # Reassign.
str = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'; # Long string.
str = '
multi
line
string
';
str = '\;'; # Escaped statement terminator.
str = '\'escape\''; # Escaped string quotations.

var inferred = 'a'; # Inferred string.
inferred = 'b'; # Reassign inferred variable.

str = conststr;


# Addition
# --------

print:'addition';

str = 'a';
str += 'b';
print:str; # ab
str += 99; # 99 = "c" in ASCII.
print:str; # abc

# Multiply
str *= 2;
print:str; # abcabc


# Access
# ------

print:'access';

str = 'abcde';

print:(str:0); # a
print:(str: -1); # e


# Methods
# -------

str = 'abcde';
print:'method length';
print:(str.length:()); # 5

print:'method append';
str.append:'fghi';
print:str; # abcdefghi

print:'method erase';
str.erase:3;
print:str; # abcefghi

print:'method raw';
print:(str.raw:()); # Get integer representation of the first character (a = 97)
