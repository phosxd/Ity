#EXPECT
#standard int
#-1000
#decl other int types
#I64
#I32
#I16
#I8
#unsigned int
#1000
#decl other uint types
#U64
#U32
#U16
#U8
#END

merge IO;

# Standard INT
# ------------

print:'standard int';

var INT int = 0;
int = 00;
int = 0_0;
int = 0 0;
int = 01;
int = 00000000000000000001;
int = -0;
int = -1;
int = -10 0_0;

print:int;

var inferred = 0;
inferred = 100;


# Other INT types
# ---------------

print:'decl other int types';

# I64 is the same as INT.
var I64 int_64 = 1;
int_64 = int;
print:(type_name:(type:int_64));

var I32 int_32 = 1;
print:(type_name:(type:int_32));

var I16 int_16 = 1;
print:(type_name:(type:int_16));

var I8 int_8 = 1;
print:(type_name:(type:int_8));


# UINT
# -----

print:'unsigned int';

var UINT uint = 1000u;
print:uint;


# Other UINT types
# ---------------

print:'decl other uint types';

# I64 is the same as INT.
var U64 uint_64 = 1;
uint_64 = uint;
print:(type_name:(type:uint_64));

var U32 uint_32 = 1;
print:(type_name:(type:uint_32));

var U16 uint_16 = 1;
print:(type_name:(type:uint_16));

var U8 uint_8 = 1;
print:(type_name:(type:uint_8));





