import Math;


# Sum
# ---

print:'sum';

print:(Math.sum:[1,3,4,2]);
print:(Math.sum:[50, 5.5]);
print:(Math.sum:[50, -55]);


# Rounding
# --------

print:'rounding';

print:(Math.round:0.5);
print:(Math.round:0.4);

print:(Math.ceil:0.5);
print:(Math.floor:0.5);


# Absolute
# ---------

print:'absolute';

print:(Math.abs: 1);
print:(Math.abs: -1);
print:(Math.abs: -9.5);
