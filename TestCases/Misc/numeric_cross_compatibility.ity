#EXPECT
#add int types
#I64, 2
#I64, 2
#I64, 2
#
#I32, 2
#I32, 2
#I32, 2
#
#I16, 2
#I16, 2
#I16, 2
#
#I8, 2
#
#add uint types
#U64, 2
#U64, 2
#U64, 2
#
#U32, 2
#U32, 2
#U32, 2
#
#U16, 2
#U16, 2
#U16, 2
#
#U8, 2
#END

# Hierarchy:
# - 64
# - 32
# - 16
# - 8
#
# - FLOAT
# - INT
# - UINT

# Adding 2 differing number types together should result
# in a variant with a type equal to the highest order
# variant in the operation.

func check;
	print:[(type_name:(type:x)), ', ', x];
	x = 0;
/;

# Define variables...

var ANY x;

var I64 i64 = 1;
var I32 i32 = 1;
var I16 i16 = 1;
var I8 i8 = 1;

var U64 u64 = 1;
var U32 u32 = 1;
var U16 u16 = 1;
var U8 u8 = 1;

var F64 f64 = 1;


# Add within int types
# --------------------

print:'add int types';

x = (i64 + i64);
check:(); # I64
x = (i64 + i32);
check:(); # I64
x = (i32 + i64);
check:(); # I64

print:[];

x = (i32 + i32);
check:(); # I32
x = (i32 + i16);
check:(); # I32
x = (i16 + i32);
check:(); # I32

print:[];

x = (i16 + i16);
check:(); # I16
x = (i16 + i8);
check:(); # I16
x = (i8 + i16);
check:(); # I16

print:[];

x = (i8 + i8);
check:(); # I8


# Add within uint types
# ----------------------

print:'\nadd uint types';

x = (u64 + u64);
check:(); # U64
x = (u64 + u32);
check:(); # U64
x = (u32 + u64);
check:(); # U64

print:[];

x = (u32 + u32);
check:(); # U32
x = (u32 + u16);
check:(); # U32
x = (u16 + u32);
check:(); # U32

print:[];

x = (u16 + u16);
check:(); # U16
x = (u16 + u8);
check:(); # U16
x = (u8 + u16);
check:(); # U16

print:[];

x = (u8 + u8);
check:(); # U8
