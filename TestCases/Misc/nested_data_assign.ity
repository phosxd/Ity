#EXPECT
#[1, 2, 3, [4, 5, 6]]
#[1, 2, 3, [4, 500, 6]]
#
#{"c": {"key": "value"}, "b": 2, "a": 1}
#{"c": {"key": [1, 2, 3]}, "b": 2, "a": 1}
#END

merge IO;

# Array...
var ARR a = [1,2,3,[4,5,6]];
print:[a];

a:3:1 = 500;
print:[a];


print:[];


# Map...
var MAP b = {'a',1, 'b',2, 'c',{'key','value'}};
print:b;

b.c.key = [1,2,3];
print:b;
