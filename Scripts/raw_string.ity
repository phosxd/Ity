import IO;


var STR string = '';
if (length:[__CMD_ARGS__] > 0);
	string = (__CMD_ARGS__:0);
/;
else;
	string = (IO.prompt:['Enter some text: ']);
/;


IO.print:[('You entered: ' + string)];
IO.print:[( (ANSI.bold)+'Here is what that is made of:'+(ANSI.reset) )];


var INT i = -1; while i < (length:[string]-1); i+=1;
	const STR ch = string:i;
	IO.print:[(ch.raw:[])];
/;
