merge IO;
import Time;
import Math;


const FPS = 8;
const FPS_ms = 1000 / FPS;

const CELL_ON =  '⬜';
const CELL_OFF = '⬛';

# Allow user defined world size.
const WORLD_SIZE = {'x',25, 'y',20};
if length:[__CMD_ARGS__] > 1;
	WORLD_SIZE.x = (__CMD_ARGS__:0 -> INT);
	WORLD_SIZE.y = (__CMD_ARGS__:1 -> INT);
/;

# Get world seed.
const SEED = prompt:'Set seed (default 0): ' -> INT;
set_seed:SEED;



func NONE _game_init;
	# Populate the world...
	for y in WORLD_SIZE.y;
		for x in WORLD_SIZE.x;
			GAME.cells.append:(rand:[0,1]);
		/;
	/;
	# Precalculate edges.
	GAME.cell_count = (length:[(GAME.cells)]);
	for i in GAME.cell_count+1;
		GAME.cell_x.append:(i % (WORLD_SIZE.x));
	/;
/;


func NONE _game_next;
	const w = WORLD_SIZE.x;
	var x = 0;
	var buf = GAME.cells; # Copy cells into writable buffer.
	for i in GAME.cell_count;
		const cell = GAME.cells:i;

		# Check boundaries & get neighboring cells...
		var l = 0; var r = 0;
		var t = 0; var b = 0;
		var tl = 0; var tr = 0;
		var bl = 0; var br = 0;
		if GAME.cell_x:i != 0;
			l = (get_cell:(i-1));
			if i >= w; tl = (get_cell:(i-w-1)); /;
			if i+w < (GAME.cell_count); bl = (get_cell:(i+w-1)); /;
		/;
		if GAME.cell_x:i != (w-1);
			r = (get_cell:(i+1));
			if i >= w; tr = (get_cell:(i-w+1)); /;
			if i+w < (GAME.cell_count); br = (get_cell:(i+w+1)); /;
		/;
		if i >= w;
			t = (get_cell:(i-w));
		/;
		if i+w < (GAME.cell_count);
			b = (get_cell:(i+w));
		/;

		# Apply rules...
		const neighbors = (l+r+t+tl+tr+b+bl+br);
		if cell == 1;
			if (neighbors < 2) || (neighbors > 3);
				buf:i = 0;
			/;
		/;
		elif neighbors == 3;
			buf:i = 1;
		/;
	/;
	# Move buffer to the main game cell array, overwriting the data previously there.
	GAME.cells <<= buf;
/;


func INT get_cell; arg INT index;
	if (index < (GAME.cell_count)) && (index >= 0);
		return GAME.cells:index;
	/;
	return 0;
/;



const GAME = {
	'init', _game_init,
	'next', _game_next,
	'cells', [],
	'cell_x', [],
	'cell_count', 0,
};


GAME.init:[];




while true;
	const start_time = Time.now:'ms';
	# Tick once.
	GAME.next:[];

	# Clear screen.
	buff_out:'\e[H\e[0J';

	# Print world...
	var i = -1;
	for cell in GAME.cells; i+=1;
		if cell == 1; buff_out:CELL_ON;  /;
		else;         buff_out:CELL_OFF; /;
		if GAME.cell_x:(i+1) == 0 && (i != (GAME.cell_count-1));
			buff_out:'\n';
		/;
	/;

	out:''; # Flushes buffered output from `buff_out`.

	# Calculate time taken to run, then sleep for the remainder of the frame time.
	const delta = (Time.now:'ms' - start_time);
	const sleep_time = (FPS_ms-delta / 1_000.0);
	if sleep_time > 0;
		sleep:(FPS_ms-delta / 1_000.0);
	/;
/;
