merge IO;
import Time;
import Math;


const FPS = 8;
const FPS_ms = 1000 / FPS;

const CELL_ON =  '⬜';
const CELL_OFF = '⬛';

# Allow user defined world size.
const WORLD_SIZE = {'x',25, 'y',20};
if length:[__CMD_ARGS__] > 1;
	WORLD_SIZE.x = (__CMD_ARGS__:0 -> INT);
	WORLD_SIZE.y = (__CMD_ARGS__:1 -> INT);
/;

# Get world seed.
var INT SEED;
var SEED_in = prompt:'Set seed (default 0): ';
if length:SEED_in == 0; SEED_in = '0'; /;
for ch in SEED_in;
	SEED += 1;
	SEED *= (ch.raw:[]); # Convert character to ASCII code & multiply that with the seed.
/;
set_seed:SEED;



func NONE _game_init;
	# Populate the world...
	for y in WORLD_SIZE.y;
		for x in WORLD_SIZE.x;
			# If boundary, always set to 0.
			if x == 0 || (x == (WORLD_SIZE.x-1))
			|| (y == 0) || (y == (WORLD_SIZE.y-1));
				GAME.cells.append:0;
			/;
			# Otherwise set to random state.
			else; GAME.cells.append:(rand:[0,1]); /;
		/;
	/;
	# Precalculate edges.
	GAME.cell_count = (length:[(GAME.cells)]);
	for i in GAME.cell_count+1;
		GAME.cell_x.append:(i % (WORLD_SIZE.x));
	/;
/;


func NONE _game_next;
	const w = WORLD_SIZE.x;
	var x = 0;
	var buf = GAME.cells; # Copy cells into writable buffer.
	for i in GAME.cell_count;
		if is_cell_border:i; continue; /;

		# Count neighboring cells...
		const neighbors = Math.sum:[
			(GAME.cells:(i-1)),
			(GAME.cells:(i-w-1)),
			(GAME.cells:(i+w-1)),
			(GAME.cells:(i+1)),
			(GAME.cells:(i-w+1)),
			(GAME.cells:(i+w+1)),
			(GAME.cells:(i-w)),
			(GAME.cells:(i+w)),
		];

		# Apply rules...
		if GAME.cells:i == 1;
			if (neighbors < 2) || (neighbors > 3);
				buf:i = 0;
			/;
		/;
		elif neighbors == 3;
			buf:i = 1;
		/;
	/;
	# Move buffer to the main game cell array, overwriting the data previously there.
	GAME.cells <<= buf;
/;


func BOOL is_cell_border; arg INT i;
	return (WORLD_SIZE.x > i)
	|| (GAME.cell_x:i == 0)
	|| (GAME.cell_x:(i+1) == 0)
	|| (i > (GAME.cell_count-(WORLD_SIZE.x)));
/;



const GAME = {
	'init', _game_init,
	'next', _game_next,
	'cells', [],
	'cell_x', [],
	'cell_count', 0,
};


GAME.init:[];




while true;
	const start_time = Time.now:'ms';

	# Tick once.
	GAME.next:[];

	# Clear screen.
	buff_out:'\e[H\e[0J';
	buff_out:(ANSI.reset);

	# Print world...
	var i = -1;
	for cell in GAME.cells; i+=1;
		if is_cell_border:i; continue; /;
		if cell == 1; buff_out:CELL_ON;  /;
		else;         buff_out:CELL_OFF; /;
		if GAME.cell_x:(i+2) == 0;
			buff_out:'\n';
		/;
	/;


	# Calculate time taken to run.
	const delta = (Time.now:'ms' - start_time);
	const sleep_time = (FPS_ms-delta / 1_000.0);

	# Print seed.
	out:['Seed: ',SEED_in,'  |  '];
	# Print frame time info.
	out:'Frame time: ';
	if sleep_time <= 0; out:(ANSI.red); /;
	else; out:(ANSI.green); /;
	out:(delta/1_000.0);
	out:(ANSI.reset);
	out:[' / ',(FPS_ms/1_000.0)];

	# Sleep for the remainder of the frame time.
	if sleep_time > 0;
		sleep:(FPS_ms-delta / 1_000.0);
	/;
/;
