#!/usr/local/bin/ity

merge IO;
import ANSI;
import Time;
import Math;


const INT FPS = 8;
const INT FPS_ms = 1000 / FPS;

const STR CELL_ON =  '██';
const STR CELL_OFF = '  ';

# Allow user defined world size.
const WORLD_SIZE = {'x',25, 'y',20};
if __CMD_ARGS__.length:[] > 1;
	WORLD_SIZE.x = (__CMD_ARGS__:0 -> INT);
	WORLD_SIZE.y = (__CMD_ARGS__:1 -> INT);
/;

# Get world seed.
var INT SEED;
var STR SEED_in = prompt:'Set seed (default 0): ';
if SEED_in.length:[] == 0; SEED_in = '0'; /;
for ch in SEED_in;
	SEED += 1;
	SEED *= (ch.raw:[]); # Convert character to ASCII code & multiply that with the seed.
/;
Math.set_seed:SEED;



func NONE _game_init;
	# Populate the world...
	for y in WORLD_SIZE.y;
		for x in WORLD_SIZE.x;
			# If boundary, always set to 0.
			if x == 0 || (x == (WORLD_SIZE.x-1))
			|| (y == 0) || (y == (WORLD_SIZE.y-1));
				GAME.cells.append:0;
			/;
			# Otherwise set to random state.
			else; GAME.cells.append:(Math.rand:[0,1]); /;
		/;
	/;
	# Precalculate edges.
	GAME.cell_count = (GAME.cells.length:[]);
	for i in GAME.cell_count+1;
		GAME.cell_x.append:(i % (WORLD_SIZE.x));
	/;
/;


func NONE _game_next;
	if GAME.stable; return; /;
	GAME.last_frame <<= (GAME.frame);
	GAME.alive_count = 0;
	GAME.generation += 1;

	const INT w = WORLD_SIZE.x;
	var ARR buf = GAME.cells; # Copy cells into writable buffer.
	for i in GAME.cell_count;
		if is_cell_border:i; continue; /;

		# Count neighboring cells...
		const INT neighbors = Math.sum:[
			(GAME.cells:(i-1)),
			(GAME.cells:(i-w-1)),
			(GAME.cells:(i+w-1)),
			(GAME.cells:(i+1)),
			(GAME.cells:(i-w+1)),
			(GAME.cells:(i+w+1)),
			(GAME.cells:(i-w)),
			(GAME.cells:(i+w)),
		];

		# Apply rules...
		if GAME.cells:i == 1;
			if (neighbors < 2) || (neighbors > 3);
				buf:i = 0;
			/;
		/;
		elif neighbors == 3;
			buf:i = 1;
		/;

		# Put cell into frame buffer.
		(buf:i == 1) ? ((GAME.alive_count += 1),(GAME.frame += CELL_ON)) -- (GAME.frame += CELL_OFF);
		if GAME.cell_x:(i+2) == 0;
			GAME.frame += '\n';
		/;
	/;

	# Move buffer to the main game cell array, overwriting the data previously there.
	GAME.cells <<= buf;
	if GAME.frame == (GAME.last_frame); GAME.stable = true; /;
/;


func BOOL is_cell_border; arg INT i_;
	return (WORLD_SIZE.x > i_)
	|| (GAME.cell_x:i_ == 0)
	|| (GAME.cell_x:(i_+1) == 0)
	|| (i_ > (GAME.cell_count-(WORLD_SIZE.x)));
/;



const MAP GAME = {
	'init', _game_init,
	'next', _game_next,
	'cell_x', [],
	'cell_count', 0,

	'stable', false,
	'generation', 0,
	'alive_count', 0,
	'frame', '',
	'last_frame', '',
	'cells', [],
};


GAME.init:[];




while true;
	const INT start_time = Time.now.ms;

	# Tick game.
	GAME.next:[];

	# Clear screen then print frame.
	out:[
		'\e[H\e[0J',
		(ANSI.reset),
		(GAME.frame),
	];

	# Calculate time taken to run.
	const INT delta = (Time.now.ms - start_time);
	const FLOAT sleep_time = (FPS_ms-delta) / 1_000.0;

	# Print details.
	out:['Seed: ',SEED_in,' | '];
	out:['Gen: ',(GAME.generation),' | '];
	out:['Alive: ',(GAME.alive_count),' | '];
	# Print frame time info.
	out:'Frame time: ';
	(sleep_time <= 0) ? (out:(ANSI.fg_red)) -- (out:(ANSI.fg_green));
	out:(delta/1_000.0);
	out:(ANSI.reset);
	out:[' / ',(FPS_ms/1_000.0)];

	# Sleep for the remainder of the frame time.
	if sleep_time > 0;
		sleep:sleep_time;
	/;
/;
