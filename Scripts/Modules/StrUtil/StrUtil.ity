# StrUtil
# -------
#
# Implements extra `STR` type methods:
#	- find
#	- erase
#	- replace
#	- replace_all
#	- split
#	- join
#	- slice
#
#
# PART OF THE STANDARD SET OF ITY MODULES.


merge IO;
# Return the index at which the `substr` was found.
# Optional `start` & optional `end` arguments can be used to dictate the slice in which to search in.
#
# Returns `-1` if not found.
func INT find; arg PTR S; arg STR substr; arg INT start = 0; arg INT end = -1;
	var substr_idx = 0;
	var found_at_idx = 0;

	if (end == -1) || (end > (length:~S));
		end = (length:~S - 1);
	/;

	var i = (start-1); while i < end; i += 1;
		if (S:i) == (substr:substr_idx);
			if substr_idx == 0; found_at_idx = i; /;
			substr_idx += 1;
			# Return if at the end of the substr.
			if substr_idx == (length:substr);
				return found_at_idx;
			/;
		/;
		else;
			found_at_idx = -1;
			substr_idx = 0;
		/;
	/;

	return -1;
/;


func NONE VarMap_set; arg PTR S; arg ANY key; arg ANY value;
	const STR key_str = ((type:key->STR)+':'+(key->STR));
	S.data += {key_str, value};
/;


const MAP __module__ = {
	'__name', 'StrUtil',
	'__tm', {
		'STR:find', find,
		#'STR:erase', erase,
	},
};



# TEST

const string = 'hello world!';
#string.find('world');
print:(find:[@string, 'world']);
