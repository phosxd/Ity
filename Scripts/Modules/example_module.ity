# This is an example module script.


# This is a custom function that will be available to the module user.
func FLOAT addf; arg FLOAT a; arg FLOAT b;
	return a + b;
/;




# All scripts can be imported freely.
# But their variables & functions will not be available by default.

# Importing a script will run it. If, after the script has ended
# we find a variable named "__module__", then we pass that to
# the original import instruction that ran the script.

const MAP __module__ = {
	'__name', 'test_module',   # Required, the module name.
	'__tm', {},                # Optional, this is where you can add custom type methods either for built-in types or your own custom data types.
	'addf', addf,
};
