# VarMap
# ------
#
# Implements a custom data container similar to `MAP`, but keys can be of any type, not just `STR`.
#
# Keys must still be convertible to `STR`, as this uses the built-in `MAP` data type internally.
#
# PART OF THE STANDARD SET OF ITY MODULES.


func MAP new;
	return {
		'__t', 'VMAP',
		'd', {},
	};
/;


# Get value in the map.
func ANY _VMAP_get; arg ANY key;
	const STR str_key = (type:[key]->STR) + ':' + (key->STR);
	return (__S.d.has:str_key) ? (__S.d:str_key) -- none;
/;
__tm__.set:['MAP(VMAP):get', _VMAP_get];


# Set key-value pair in the map.
# This overrides the default `set` method for `MAP(v)`.
func NONE _VMAP_set; arg ANY key; arg ANY value;
	const STR key_str = (type:[key]->STR) + ':' + (key->STR);
	__S.d.set:[key_str, value];
/;
__tm__.set:['MAP(VMAP):set', _VMAP_set];


const MAP __module__ = {
	'__name', 'VarMap',
	'__tm', {
		'MAP(VMAP):get', _VMAP_get,
		'MAP(VMAP):set', _VMAP_set,
	},
	'new', new,
};
