# ExtendedSystem
# --------------
#
# Implements useful functions for interacting with the OS.
#
#
# PART OF THE STANDARD SET OF ITY MODULES.

import Math;
import FileSystem as FS;


# Generate a temporary path, unique to this script instance.
const STR tmp_path = '/tmp/ity_es_' + (Math.rand:[0, 100_000]/100_000.0 -> STR);
const STR tmp_out_path = tmp_path+'_out';
const STR tmp_err_path = tmp_path+'_err';


# Execute command & return the output
func MAP ES_call; arg STR cmd;
	const MAP res = {
		'code', (system:(cmd + ' >'+tmp_out_path + ' 2>'+tmp_err_path)), # Run command.
		'out',  (FS.read:tmp_out_path), # Read output file.
		'err',  (FS.read:tmp_err_path), # Read error file.
	};
	# Delete files.
	FS.remove:tmp_out_path;
	FS.remove:tmp_err_path;

	return res;
/;




const MAP __module__ = {
	'__name', 'ExtendedSystem',

	'tmp_path', tmp_path,
	'tmp_out_path', tmp_out_path,
	'tmp_err_path', tmp_err_path,

	'call', ES_call,
};
