# StrUtil
# -------
#
# Implements extra `STR` type methods:
#	- find
#	- erase
#	- slice
#	- replace
#	- replace_all
#	* split
#	* join
#
#
# PART OF THE STANDARD SET OF ITY MODULES.


# Return the index at which the `substr` was found. `-1` if not found.
# Optional `start` & optional `end` arguments can be used to dictate the slice in which to search in.
func INT STR_find; arg PTR S; arg STR substr; arg INT start = 0; arg INT end = -1;
	var INT substr_idx = 0;
	var INT found_at_idx = 0;

	if (end == -1) || (end > (S.length:[])); end = (S.length:[] - 1); /;

	var INT i = (start-1); while i < end; i += 1;
		if (S:i) == (substr:substr_idx);
			if substr_idx == 0; found_at_idx = i; /;
			substr_idx += 1;
			# Return if at the end of the substr.
			if substr_idx == (substr.length:[]);
				return found_at_idx;
			/;
		/;
		else;
			found_at_idx = -1;
			substr_idx = 0;
		/;
	/;

	return -1;
/;


# Erase a character from the string, by index.
func NONE STR_erase; arg PTR S; arg INT index;
	var STR new_str;
	var INT i = -1; while i < (S.length:[] - 1); i+=1;
		if i == index; continue; /;
		new_str += (S:i);
	/;
	S = new_str;
/;


# Get a slice of the string.
func STR STR_slice; arg PTR S; arg INT start = 0; arg INT end = -1;
	var STR str_slice;
	if (end == -1) || (end > (S.length:[])); end = (S.length:[] - 1); /;

	var INT i=start-1; while i < end; i+=1;
		str_slice += (S:i);
	/;
	return str_slice;
/;


# Find & replace the first occurance of `a` with `b` in the string, returning a new string.
func STR STR_replace; arg PTR S; arg STR a; arg STR b;
	const INT index = STR_find:[S, a];
	if index == -1; return ~S; /;

	# Slice around `a` & return a string with `b` placed in between the slices.
	const STR part_1 = STR_slice:[S, 0, (index-1)];
	const STR part_2 = STR_slice:[S, (index+(a.length:[])), -1];
	return part_1 + b + part_2;
/;


# Find & replace the all occurances of `a` with `b` in the string, returning a new string.
func STR STR_replace_all; arg PTR S; arg STR a; arg STR b;
	var STR new_str = ~S;
	while true;
		var STR new_str_ = STR_replace:[(&>new_str), a,b];
		if new_str_ == new_str; break; /;
		new_str <<= new_str_;
	/;
	return new_str;
/;




const MAP __module__ = {
	'__name', 'StrUtil',
	'__tm', {
		'STR:find',        STR_find,
		'STR:erase',       STR_erase,
		'STR:slice',       STR_slice,
		'STR:replace',     STR_replace,
		'STR:replace_all', STR_replace_all,
	},
};
