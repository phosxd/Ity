# Limits
# -------
#
# Defines various language constant values & ranges.
#
#
# PART OF THE STANDARD SET OF ITY MODULES.


const I8 i8_x =  127;
const I8 i8_n = -128;
const I16 i16_x =  32_767;
const I16 i16_n = -32_768;
const I32 i32_x =  2_147_483_647;
const I32 i32_n = -2_147_483_648;
const I64 i64_x =  9_223_372_036_854_775_807;
const I64 i64_n = -9_223_372_036_854_775_808;

const UI8 ui8_x = 255;
const UI8 ui8_n = 0;
const UI16 ui16_x = 65_535;
const UI16 ui16_n = 0;
const UI32 ui32_x = 4_294_967_296;
const UI32 ui32_n = 0;
const UI64 ui64_x = 18_446_744_073_709_551_616;
const UI64 ui64_n = 0;

# Min/max are not the true limits, only an approximation.
const F64 f64_x   = .0;
const F64 f64_n   = 0-f64_x;
const F64 f64_inf = f64_x+f64_x;


const MAP __module__ = {
	'__name', 'Limits',

	'I8_max', i8_x,
	'I8_min', i8_n,
	'I16_max', i16_x,
	'I16_min', i16_n,
	'I32_max', i32_x,
	'I32_min', i32_n,
	'I64_max', i64_x,
	'I64_min', i64_n,

	'UI8_max', ui8_x,
	'UI8_min', ui8_n,
	'UI16_max', ui16_x,
	'UI16_min', ui16_n,
	'UI32_max', ui32_x,
	'UI32_min', ui32_n,
	'UI64_max', ui64_x,
	'UI64_min', ui64_n,

	'F64_max', f64_x,
	'F64_min', f64_n,
	'F64_inf', f64_inf,

	'STR_byte_max', i8_x,
	'STR_byte_min', i8_n,
};
