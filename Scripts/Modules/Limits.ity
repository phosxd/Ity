# Limits
# -------
#
# Defines various language constant values & ranges.
#
#
# PART OF THE STANDARD SET OF ITY MODULES.


const I8 i8_x =  127;
const I8 i8_n = -128;
const I16 i16_x =  32_767;
const I16 i16_n = -32_768;
const I32 i32_x =  2_147_483_647;
const I32 i32_n = -2_147_483_648;
const I64 i64_x =  9_223_372_036_854_775_807;
const I64 i64_n = -9_223_372_036_854_775_808;

const U8 u8_x = 255;
const U8 u8_n = 0;
const U16 u16_x = 65_535;
const U16 u16_n = 0;
const U32 u32_x = 4_294_967_295;
const U32 u32_n = 0;
const U64 u64_x = 18_446_744_073_709_551_615u;
const U64 u64_n = 0;

# Min/max are not the true limits, only an approximation.
const F64 f64_x   = .0;
const F64 f64_n   = 0-f64_x;
const F64 f64_inf = f64_x+f64_x;


const MAP __module__ = {
	'__name', 'Limits',

	'I8_max', i8_x,
	'I8_min', i8_n,
	'I16_max', i16_x,
	'I16_min', i16_n,
	'I32_max', i32_x,
	'I32_min', i32_n,
	'I64_max', i64_x,
	'I64_min', i64_n,

	'U8_max', u8_x,
	'U8_min', u8_n,
	'U16_max', u16_x,
	'U16_min', u16_n,
	'U32_max', u32_x,
	'U32_min', u32_n,
	'U64_max', u64_x,
	'U64_min', u64_n,

	'F64_max', f64_x,
	'F64_min', f64_n,
	'F64_inf', f64_inf,

	'STR_byte_max', i8_x,
	'STR_byte_min', i8_n,
};
