#!/usr/local/bin/ity
import IO;
import ANSI;


func FLOAT add; arg FLOAT first; arg FLOAT second;
	return a+b;
/;


IO.print:[(ANSI.bold), 'Add 2 numbers...', (ANSI.reset)];

const a = IO.prompt:'Value 1: ' -> FLOAT;
const b = IO.prompt:'Value 2: ' -> FLOAT;

IO.print:[(ANSI.fg_yellow), 'Sum: ', (add:[a,b]), (ANSI.reset)];
