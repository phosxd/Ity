#!/usr/local/bin/ity
import ANSI;


func FLOAT add; arg FLOAT first; arg FLOAT second;
	return first + second;
/;


print:[(ANSI.bold), 'Add 2 numbers...', (ANSI.reset)];

const a = IO.prompt:'Value 1: ' -> FLOAT;
const b = IO.prompt:'Value 2: ' -> FLOAT;

print:[(ANSI.fg_yellow), 'Sum: ', (add:[a,b]), (ANSI.reset)];
