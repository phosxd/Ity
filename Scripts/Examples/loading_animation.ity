#!/usr/local/bin/ity
import ANSI;


const ARR frames = ['|','/','-','\\'];


# Run through the animation forever.
func NONE do_animation;
	out:(ANSI.cursor_off); # Hide the terminal cursor.
	while true;
		for i in frames.length:[];
			out:['\e[1G',' ',(frames:i)];
			sleep:0.133;
		/;
	/;
/;


# Called when the program is interrupted or finished.
func NONE done;
	out:(ANSI.cursor_on); # Show the terminal cursor.
	out:'\e[2K\e[1G'; # Clear the line & set the cursor to the beginning.
	print:'Done!';

	exit;
/;


signal:[(SIGNAL.interrupt), done];
do_animation:[];
done:[];
