merge IO;


var STR string = '';
if (length:[__CMD_ARGS__] > 0);
	string = (__CMD_ARGS__:0);
/;
else;
	string = (IO.prompt:['Enter some text: ']);
/;


print:[('You entered: ' + string)];
print:[( (ANSI.bold)+'Here is what that is made of:'+(ANSI.reset) )];


for ch in string;
	print:[(ch.raw:[])];
/;
