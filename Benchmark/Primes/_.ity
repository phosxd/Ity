merge Time;


func U64 isqrt; arg UINT n;
	var x = n;
	var y = ((x+1u) / 2u); while y < x;
		x = y;
		y = ( ((n/x) + x) / 2u);
	/; return x;
/;


func BOOL is_prime; arg U64 n;
	if n%2 == 0; return n == 2; /;
	const U64 r = isqrt:n + 1;
	var U64 i=3; while i < r;
		if n%i == 0; return false; /;
		i+=2u;
	/;
	return true;
/;


const count = prompt:'Count: ' -> U64;
const U64 start = now.us;


for p in count;
	if is_prime:p; print:p; /;
/;


print:['\nDone in ', (now.us-start / 1_000_000.0), 's.'];
