merge IO; merge Time;


func UINT isqrt; arg UINT n;
	var x = n;
	var y = ((x+1u) / 2u); while y < x;
		x = y;
		y = ( ((n/x) + x) / 2u);
	/; return x;
/;


func BOOL is_prime; arg UINT n;
	if n%2u == 0u; return n == 2u; /;
	const r = isqrt:n + 1u;
	var i=3u; while i < r;
		if n%i == 0u; return false; /;
		i+=2u;
	/;
	return true;
/;


const count = prompt:'Count: ' -> UINT;
const UINT start = now.us;


for p in count;
	if is_prime:p; print:p; /;
/;


print:['\nDone in ', (now.us-start / 1_000_000.0), 's.'];
